/* achievements */
.ach{display:grid;gap:0}
.ach article{display:grid;grid-template-columns:minmax(120px,22%) 1fr;gap:2rem;align-items:baseline;padding:2rem 0;border-top:1px solid rgba(239,233,220,.25)}
.ach .big{font-size:clamp(4rem,10vw,9rem)}
.ach h3{font:800 clamp(1.4rem,2.5vw,2rem)/1.1 var(--display);text-transform:uppercase;margin-bottom:.4rem}
@media(max-width:600px){.ach article{grid-template-columns:1fr;gap:.5rem}}
.stats{display:flex;gap:3rem;flex-wrap:wrap;margin-top:3rem}
.stats b{display:block;font:900 clamp(3rem,7vw,5.5rem)/1 var(--display);color:var(--yellow)}
/* projects */
.proj{display:grid;grid-template-columns:repeat(12,1fr);gap:2rem;margin-bottom:clamp(4rem,10vw,8rem);align-items:center}
.proj .vis{grid-column:1/8;aspect-ratio:16/10;position:relative;overflow:hidden;clip-path:inset(0 0 0 0);background:var(--ink2)}
.proj:nth-child(even) .vis{grid-column:6/13;grid-row:1}
.proj .txt{grid-column:8/13}
.proj:nth-child(even) .txt{grid-column:1/6;grid-row:1}
.proj h3{font-size:clamp(2.4rem,5vw,4.5rem);margin:.6rem 0 1rem}
.vis svg{width:100%;height:100%;display:block}
.vis .inner{position:absolute;inset:-8% 0}
.proj ul{list-style:none;margin-top:1rem}.proj li{padding:.3rem 0;border-bottom:1px solid rgba(239,233,220,.12)}
.soon{display:inline-block;margin-top:1rem;padding:.3rem .6rem;border:1px dashed var(--yellow);color:var(--yellow)}
@media(max-width:820px){.proj .vis,.proj .txt,.proj:nth-child(even) .vis,.proj:nth-child(even) .txt{grid-column:1/-1;grid-row:auto}}
/* gallery */
.gal{display:grid;grid-template-columns:repeat(6,1fr);gap:1rem}
.gal figure{grid-column:span 2;position:relative}
.gal figure:nth-child(1){grid-column:span 3}.gal figure:nth-child(2){grid-column:span 3;margin-top:3rem}
.gal .fr{aspect-ratio:4/3;cursor:default;background:var(--ink2);border:1px solid rgba(239,233,220,.2);overflow:hidden;display:grid;place-content:center;color:var(--dim)}
