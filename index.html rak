.cols{display:grid;grid-template-columns:repeat(12,1fr);gap:2rem}
h2.disp{font-size:clamp(3rem,9vw,8rem);margin-bottom:2.5rem}
.rule{border-top:1px solid rgba(239,233,220,.25);padding-top:1rem}
.lead{font-size:clamp(1.4rem,2.6vw,2.2rem);line-height:1.3;grid-column:1/9}
.aside{grid-column:9/13}
