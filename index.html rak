<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/motion@11.11.17/dist/motion.js"></script>
<script>
/* ============ CONFIG: fill these in (nothing is invented) ============ */
const CONFIG={
  photo:"data:image/jpeg;base64,",        // e.g. "rakshitha.jpg" (your real portrait)
  email:"rakshitharm1424@gamil.com",
  phone:"9742114082",        // your real email address
  linkedin:"",     // full URL, e.g. https://www.linkedin.com/in/...
  github:"",       // full URL, e.g. https://github.com/...
  gallery:["data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,"] // image paths in caption order
};
/* ===================================================================== */
const RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
const LOW=(navigator.hardwareConcurrency||8)<=2||(navigator.deviceMemory||8)<=2;
if(LOW)document.documentElement.classList.add('low');
const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>[...r.querySelectorAll(s)];
gsap.registerPlugin(ScrollTrigger);
const M=window.Motion||{};

/* ---- portrait + gallery from config ---- */
if(CONFIG.photo){const i=new Image();i.src=CONFIG.photo;i.alt="Portrait of Rakshitha RM";i.className="par-img";i.fetchPriority="high";i.onload=()=>{$('#ph').remove();$('#portrait').prepend(i)}}
const caps=["NCC ‘A’ Certificate, 2023","NCC Annual Training Camp, 2022–23","Global Kids Abacus: 3rd Prize trophy","Global Kids Abacus: Merit Certificate, 2019","Science Talent Examination, 2014","DCL National IQ Scholarship: Certificate of Merit, 2023"];
$('#gal').innerHTML=caps.map((c,i)=>`<figure class="rv"><div class="fr">${CONFIG.gallery[i]?`<img loading="lazy" src="${CONFIG.gallery[i]}" alt="${c}">`:`<span class="mono">Image ${i+1} to be added</span>`}</div><figcaption class="mono">${c}</figcaption></figure>`).join('');

/* ---- reusable flashlight: Torch(el,{radius,ease}) ---- */
class Torch{
  constructor(el,o={}){
    this.el=el;this.r=o.radius||+el.dataset.radius||220;this.k=LOW||RM?1:(o.ease||.16);
    this.tx=this.x=innerWidth*.68;this.ty=this.y=innerHeight*.42;this.raf=0;this.on=true;
    el.style.setProperty('--r',(LOW?this.r*.8:this.r)+'px');
    this.move=e=>{const b=el.getBoundingClientRect();this.tx=e.clientX-b.left;this.ty=e.clientY-b.top;this.kick()};
    this.touch=e=>{if(e.pointerType==='touch'){this.r=Math.max(this.r,150);el.style.setProperty('--r',this.r+'px')}};
    el.addEventListener('pointermove',this.move,{passive:true});
    el.addEventListener('pointerdown',this.move,{passive:true});
    el.addEventListener('pointerdown',this.touch,{passive:true});
    this.io=new IntersectionObserver(([e])=>{this.on=e.isIntersecting;if(this.on)this.kick()});this.io.observe(el);
    this.set();
  }
  set(){this.el.style.setProperty('--x',this.x+'px');this.el.style.setProperty('--y',this.y+'px')}
  kick(){if(!this.raf&&this.on)this.raf=requestAnimationFrame(()=>this.tick())}
  tick(){this.raf=0;const dx=this.tx-this.x,dy=this.ty-this.y;
    this.x+=dx*this.k;this.y+=dy*this.k;this.set();
    if(Math.abs(dx)>.4||Math.abs(dy)>.4)this.kick()}
  destroy(){cancelAnimationFrame(this.raf);this.io.disconnect();['pointermove','pointerdown'].forEach(t=>this.el.removeEventListener(t,this.move));this.el.removeEventListener('pointerdown',this.touch)}
}
const torch=new Torch($('#hero'));

/* ---- GSAP: scoped context ---- */
const ctx=gsap.context(()=>{
  if(RM){$$('.stat,[data-n]').forEach(n=>n.textContent=n.dataset.n);return}
  // opening timeline
  gsap.timeline({defaults:{ease:'expo.out'}})
    .from('.h-line',{yPercent:110,duration:1.5,stagger:.12,delay:.2})
    .from('.h-fade',{opacity:0,y:14,duration:1,stagger:.1},'-=.9')
    .from('#portrait',{clipPath:'inset(100% 0 0 0)',duration:1.4},'-=1.2')
    .from('#portrait .ph b,#portrait img',{scale:1.3,duration:1.8},'<');
  // portrait parallax
  gsap.to('#portrait img,#portrait .ph',{yPercent:-8,ease:'none',scrollTrigger:{trigger:'#hero',start:'top top',end:'bottom top',scrub:true}});
  // section reveals
  $$('.rv').forEach(el=>gsap.from(el,{opacity:0,y:40,duration:1,ease:'power3.out',scrollTrigger:{trigger:el,start:'top 88%',once:true}}));
  // project image masks + parallax
  $$('.mask').forEach(m=>{
    gsap.from(m,{clipPath:'inset(0 100% 0 0)',duration:1.4,ease:'expo.inOut',scrollTrigger:{trigger:m,start:'top 80%',once:true}});
    gsap.fromTo($('.par',m),{yPercent:-6},{yPercent:6,ease:'none',scrollTrigger:{trigger:m,scrub:true}});
  });
  // counters
  $$('[data-n]').forEach(n=>{const o={v:0};gsap.to(o,{v:+n.dataset.n,duration:1.6,ease:'power2.out',scrollTrigger:{trigger:n,start:'top 90%',once:true},onUpdate:()=>n.textContent=Math.round(o.v)})});
  // outlined display text fills as it passes
  $$('#achievements .big').forEach(b=>gsap.to(b,{color:'#f2c230',webkitTextStrokeColor:'#f2c230',ease:'none',scrollTrigger:{trigger:b,start:'top 75%',end:'top 35%',scrub:true}}));
  // nav active
  $$('main section').forEach(s=>ScrollTrigger.create({trigger:s,start:'top 45%',end:'bottom 45%',onToggle:t=>{const a=$(`nav a[href="#${s.id}"]`);a&&a.classList.toggle('on',t.isActive)}}));
});

/* ---- Collaborate: strings + hand ---- */
const stage=$('#stage'),svg=$('#strings'),hand=$('#hand'),bw=$('#bw'),cta=$('#cta'),tips=$$('.tip');
const N=5,ns='http://www.w3.org/2000/svg',paths=[],st={t:0,px:0,py:0,vis:true};
for(let i=0;i<N;i++){const p=document.createElementNS(ns,'path');p.setAttribute('pathLength','1');p.style.strokeDasharray='1';p.style.strokeDashoffset=RM?0:1;p.style.strokeWidth=(.8+Math.random()*.7).toFixed(2);svg.appendChild(p);paths.push(p)}
const seed=[...Array(N)].map(()=>({a:6+Math.random()*10,f:.8+Math.random()*.8,ph:Math.random()*6.28,b:20+Math.random()*50}));
function draw(){
  const s=stage.getBoundingClientRect(),b=cta.getBoundingClientRect();
  if(!s.width)return;
  paths.forEach((p,i)=>{
    const t=tips[i].getBoundingClientRect(),sx=t.left-s.left+t.width/2,sy=t.top-s.top+t.height/2;
    const ex=b.left-s.left+(i%2?6:14),ey=b.top-s.top+b.height*((i+1)/(N+1));
    const k=seed[i],sw=RM?0:Math.sin(st.t*k.f+k.ph)*k.a;
    const cx=(sx+ex)/2+sw+st.px*(8+i*2),cy=(sy+ey)/2+k.b+st.py*6+Math.cos(st.t*k.f+k.ph)*k.a*.5;
    p.setAttribute('d',`M${sx} ${sy}Q${cx} ${cy} ${ex} ${ey}`);
  });
}
draw();
let rz;addEventListener('resize',()=>{clearTimeout(rz);rz=setTimeout(draw,60)});
const sctx=gsap.context(()=>{
  if(RM)return;
  const tl=gsap.timeline({scrollTrigger:{trigger:'#collab',start:'top 65%',once:true}});
  tl.from('#collab h2,#collab .mono',{y:50,opacity:0,duration:1.1,ease:'power3.out',stagger:.1})
    .from(bw,{opacity:0,scale:.8,duration:1,ease:'back.out(1.6)'},'-=.6')
    .from(hand,{x:-80,opacity:0,duration:1.1,ease:'power3.out'},'<')
    .to(paths,{strokeDashoffset:0,duration:1.8,stagger:.12,ease:'power2.inOut'},'-=.4');
  const pull=gsap.timeline({repeat:-1,yoyo:true,paused:true}).to(hand,{x:-7,y:5,rotation:-2.2,duration:1.9,ease:'sine.inOut'}).to(hand,{x:4,y:-3,rotation:1,duration:2.3,ease:'sine.inOut'});
  const tick=()=>{st.t+=gsap.ticker.deltaRatio()/60;draw()};
  ScrollTrigger.create({trigger:'#collab',start:'top bottom',end:'bottom top',onToggle:s=>{if(s.isActive){pull.play();gsap.ticker.add(tick)}else{pull.pause();gsap.ticker.remove(tick)}}});
  const qx=gsap.quickTo(st,'px',{duration:1.2}),qy=gsap.quickTo(st,'py',{duration:1.2});
  const pm=e=>{const s=stage.getBoundingClientRect();qx((e.clientX-s.left)/s.width*2-1);qy((e.clientY-s.top)/s.height*2-1)};
  stage.addEventListener('pointermove',pm,{passive:true});
  return()=>{stage.removeEventListener('pointermove',pm);gsap.ticker.remove(tick)};
});

/* ---- Motion (Framer Motion's vanilla engine): buttons, nav, overlay ---- */
if(M.hover&&M.animate&&!RM){
  M.hover(cta,()=>{M.animate(bw,{y:-6,scale:1.05},{type:'spring',stiffness:300,damping:18});return()=>M.animate(bw,{y:0,scale:1},{type:'spring',stiffness:300,damping:20})});
  M.press(cta,()=>{M.animate(cta,{scale:.95},{duration:.12});return()=>M.animate(cta,{scale:1},{type:'spring',stiffness:400,damping:15})});
  $$('nav a').forEach(a=>{M.hover(a,()=>{M.animate(a,{y:-2},{duration:.2});return()=>M.animate(a,{y:0},{duration:.2})});M.press(a,()=>{M.animate(a,{scale:.94},{duration:.1});return()=>M.animate(a,{scale:1},{duration:.15})})});
}
// 3D tilt via CSS vars (transform on .cta is CSS-only; Motion animates the wrapper + scale)
cta.addEventListener('pointermove',e=>{if(RM||e.pointerType==='touch')return;const r=cta.getBoundingClientRect();cta.style.setProperty('--ry',((e.clientX-r.left)/r.width-.5)*14+'deg');cta.style.setProperty('--rx',(.5-(e.clientY-r.top)/r.height)*14+'deg')});
cta.addEventListener('pointerleave',()=>{cta.style.setProperty('--rx','0deg');cta.style.setProperty('--ry','0deg')});

/* ---- contact overlay ---- */
const ov=$('#ov'),panel=$('#panel');let last=null;
function row(id,val,href,label){const el=$(id);el.innerHTML=val?`<a href="${href}" ${href.startsWith('http')?'target="_blank" rel="noopener"':''}>${label||val}</a>`:(el.parentElement.style.display='none','')}
row('#c-mail',CONFIG.email,'mailto:'+CONFIG.email);
row('#c-ph',CONFIG.phone,'tel:'+CONFIG.phone,CONFIG.phone);
row('#c-li',CONFIG.linkedin,CONFIG.linkedin,'LinkedIn profile');
row('#c-gh',CONFIG.github,CONFIG.github,'GitHub profile');
const start=$('#start');
if(CONFIG.email){start.href='mailto:'+CONFIG.email+'?subject='+encodeURIComponent('Let’s start a project')}else{start.setAttribute('aria-disabled','true');start.addEventListener('click',e=>e.preventDefault())}
function openOv(){
  last=document.activeElement;ov.classList.add('open');ov.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';
  const r=cta.getBoundingClientRect();
  if(M.animate&&!RM){
    M.animate(ov,{opacity:[0,1]},{duration:.3});
    M.animate(panel,{opacity:[0,1],scale:[.6,1],x:[r.left+r.width/2-innerWidth/2,0],y:[r.top+r.height/2-innerHeight/2,0]},{type:'spring',stiffness:220,damping:26});
  }
  $('#close').focus();
}
function closeOv(){
  const done=()=>{ov.classList.remove('open');ov.setAttribute('aria-hidden','true');document.body.style.overflow='';last&&last.focus()};
  M.animate&&!RM?M.animate(ov,{opacity:0},{duration:.2}).finished.then(done):done();
}
cta.addEventListener('click',openOv);
$('#close').addEventListener('click',closeOv);
ov.addEventListener('pointerdown',e=>{if(e.target===ov)closeOv()});
addEventListener('keydown',e=>{
  if(!ov.classList.contains('open'))return;
  if(e.key==='Escape')closeOv();
  if(e.key==='Tab'){const f=$$('a[href],button',panel).filter(x=>x.getAttribute('aria-disabled')!=='true');const a=f[0],z=f[f.length-1];
    if(e.shiftKey&&document.activeElement===a){e.preventDefault();z.focus()}else if(!e.shiftKey&&document.activeElement===z){e.preventDefault();a.focus()}}
});

/* ---- cleanup ---- */
addEventListener('pagehide',()=>{torch.destroy();ctx.revert();sctx.revert();ScrollTrigger.killAll()});
</script>
