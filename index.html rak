section{position:relative;padding:clamp(5rem,12vw,10rem) clamp(1rem,4vw,3rem)}
.wrap{max-width:1280px;margin:0 auto}
/* hero + torch */
#hero{min-height:100svh;padding-top:6rem;padding-bottom:2rem;display:grid;align-items:end;overflow:hidden;position:relative;--x:68%;--y:42%;--r:230px;background:radial-gradient(120% 80% at 80% 20%,#1b1612,var(--ink) 60%)}
.hero-grid{position:relative;display:grid;grid-template-columns:1.25fr .75fr;gap:2rem;align-items:end;max-width:1400px;width:100%;margin:0 auto}
.layer{position:absolute;inset:0;padding:6rem clamp(1rem,4vw,3rem) 2rem;display:grid;align-items:end}
.torch-reveal{z-index:3;pointer-events:none;-webkit-mask-image:radial-gradient(circle var(--r) at var(--x) var(--y),#000 0,rgba(0,0,0,.9) 30%,rgba(0,0,0,.35) 62%,transparent 100%);mask-image:radial-gradient(circle var(--r) at var(--x) var(--y),#000 0,rgba(0,0,0,.9) 30%,rgba(0,0,0,.35) 62%,transparent 100%)}
.torch-reveal .name{color:var(--yellow);-webkit-text-stroke:0}
.torch-reveal .note{color:var(--ivory)}
.torch-glow{position:absolute;inset:0;z-index:4;pointer-events:none;mix-blend-mode:screen;background:radial-gradient(circle calc(var(--r)*1.6) at var(--x) var(--y),rgba(255,214,120,.14),transparent 70%)}
.low .torch-glow{display:none}
.name{font-size:clamp(4rem,14.5vw,13.5rem)}
.cap{margin-bottom:1.2rem}
.sub{font-size:clamp(1.05rem,1.6vw,1.35rem);max-width:34ch;margin-top:1.5rem;color:var(--dim)}
.note{font:italic 400 1rem var(--serif);display:block;margin-top:.4rem}
.portrait{position:relative;aspect-ratio:3/4;width:100%;max-width:420px;justify-self:end;overflow:hidden;background:linear-gradient(160deg,#2a221b,#0f0c0a);border:1px solid rgba(239,233,220,.2)}
.portrait img{width:100%;height:112%;object-fit:cover;object-position:50% 18%;filter:saturate(1.04)}
.portrait::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,transparent 60%,rgba(10,9,8,.6));box-shadow:inset 0 0 0 1px rgba(242,194,48,.35)}
.portrait .ph{position:absolute;inset:0;display:grid;place-content:center;text-align:center;gap:.5rem;padding:1rem}
.portrait .ph b{font:900 7rem var(--display);color:transparent;-webkit-text-stroke:1.5px var(--yellow)}
.tag{position:absolute;left:0;bottom:0;background:var(--red);color:var(--ivory);padding:.35rem .7rem}
.scroll{position:absolute;right:clamp(1rem,4vw,3rem);top:50%;writing-mode:vertical-rl;z-index:5}
