.aside li,.skills li{padding:.35rem 0;border-bottom:1px solid rgba(239,233,220,.12)}
.cols .third{grid-column:span 4}
@media(max-width:820px){.lead,.aside,.cols .third{grid-column:1/-1}}
.blue{color:var(--blue)}.red{color:var(--red)}.y{color:var(--yellow)}
/* edu timeline */
.edu{display:grid;gap:0}
