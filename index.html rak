.panel .row{display:flex;justify-content:space-between;gap:1rem;padding:.9rem 0;border-top:1px solid rgba(13,12,11,.2);font-size:1.05rem;word-break:break-all}
.panel .row a{color:#0d0c0b}
.panel .row span.cfg{color:var(--red);font:500 .8rem var(--mono)}
.close{position:absolute;right:1rem;top:1rem;width:44px;height:44px;border-radius:50%;border:1px solid #0d0c0b;background:transparent;font-size:1.4rem;cursor:pointer;color:#0d0c0b}
.start{display:inline-block;margin-top:1.4rem;background:#0d0c0b;color:#f4f1ea;padding:1rem 1.8rem;border-radius:999px;font:800 1.1rem var(--display);letter-spacing:.12em;text-decoration:none;border:0;cursor:pointer}
.start[aria-disabled=true]{opacity:.45;cursor:not-allowed}
footer{padding:3rem clamp(1rem,4vw,3rem);display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem}
@media(prefers-reduced-motion:reduce){.grain{animation:none}html{scroll-behavior:auto}.cta,.cta::after{transition:none}}
</style>
