*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--ink);color:var(--ivory);font:400 1.125rem/1.6 var(--serif);overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{color:inherit}
