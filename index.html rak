.hand{position:absolute;left:0;bottom:0;width:clamp(150px,24vw,260px);transform-origin:20% 100%}
.btn-wrap{position:absolute;left:58%;top:30%;transform:translate(-50%,-50%);perspective:700px}
.cta{position:relative;overflow:hidden;border:0;cursor:pointer;color:#f4f1ea;font:800 clamp(.95rem,1.8vw,1.35rem)/1 var(--display);letter-spacing:.14em;padding:1.35rem clamp(1.6rem,4vw,3rem);border-radius:999px;background:linear-gradient(180deg,#3a3835 0,#0c0b0a 18%,#000 60%,#1b1a18 100%);box-shadow:0 18px 30px -12px rgba(0,0,0,.55),0 2px 0 rgba(255,255,255,.18) inset,0 -3px 6px rgba(255,255,255,.06) inset;transform:rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .2s ease-out;white-space:nowrap}
.cta::after{content:"";position:absolute;top:0;bottom:0;width:40%;left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.45),transparent);transform:skewX(-20deg)}
.cta:hover::after{left:130%;transition:left .8s ease}
.alt{display:none;margin-top:1rem}
@media(hover:none){.alt{display:block}}
/* overlay */
#ov{position:fixed;inset:0;z-index:80;display:none;place-items:center;background:rgba(10,9,8,.82);padding:1rem}
